---
import strings from "../strings.json";
import { BASE, OG, version } from "../site.js";
import cargo from "../../../Cargo.toml?raw";

const { lang, name, doc = false } = Astro.props;
const s = strings[lang];
const [title, description] = s.pages[name];
const file = name === "index" ? "" : `${name}.html`;
const [ogImage, ogLocale] = OG[lang];
const origin = Astro.site.origin;
const url = origin + BASE[lang] + file;
const license = cargo.match(/^license = "(.+)"$/m)[1].split(" OR ");

const softwareApplication = name === "index" && {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "repoke",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  softwareVersion: version,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  license: license.map((id) => `https://spdx.org/licenses/${id}`),
  url,
  codeRepository: "https://github.com/paveldelpozo/repoke",
  downloadUrl: "https://github.com/paveldelpozo/repoke/releases",
  author: { "@type": "Person", name: "Pavel del Pozo" },
  inLanguage: lang,
};

const nav = s.nav.map(([href, label]) => {
  const url = href.startsWith("http") ? href : BASE[lang] + href;
  return { url, label, current: file !== "" && url.endsWith(file) };
});
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>
  <link rel="alternate" hreflang="en" href={origin + BASE.en + file}>
  <link rel="alternate" hreflang="es" href={origin + BASE.es + file}>
  <link rel="alternate" hreflang="x-default" href={origin + BASE.en + file}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="repoke">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:image" content={`${origin}/${ogImage}`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={s.og_alt}>
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>
    // Before the first paint: the saved theme, the visitor's OS for the install tabs, and the
    // language (saved, else the browser's).
    (function () {
      var root = document.documentElement, theme, lang;
      try { theme = localStorage.getItem("theme"); lang = localStorage.getItem("lang"); } catch (e) {}
      if (theme === "light" || theme === "dark") root.dataset.theme = theme;
      var platform = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent).toLowerCase();
      root.dataset.os = root.dataset.yourOs = /win/.test(platform) ? "windows" : /linux|x11|cros|chrome os|android/.test(platform) ? "linux" : "mac";
      if (!lang) {
        lang = (navigator.languages || [navigator.language || ""])
          .map(function (l) { return String(l).slice(0, 2).toLowerCase(); })
          .filter(function (l) { return l === "en" || l === "es"; })[0] || "en";
      }
      if (lang !== root.lang) {
        var other = document.querySelector('link[rel="alternate"][hreflang="' + lang + '"]');
        if (other) location.replace(new URL(other.href).pathname + location.hash);
      }
    })();
  </script>
  {softwareApplication && <script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />}
  <link rel="stylesheet" href="/style.css">
  <script is:inline src="/site.js" defer></script>
  <script is:inline src="/consent.js" defer></script>
</head>
<body data-copy={s.copy} data-copied={s.copied} data-copy-failed={s.copy_failed}>
  <a class="skip" href="#main">{s.skip}</a>
  <header class="top">
    <a class="brand" href={BASE[lang]} aria-label={s.home_label}>
      <img src="/logo.svg" alt="" width="66" height="44">
      <span>repoke</span>
    </a>
    <div class="prefs">
      <label class="visually-hidden" for="lang">{s.language}</label>
      <select id="lang" class="pref">
        <option value={BASE.en + file} lang="en" selected={lang === "en"}>English</option>
        <option value={BASE.es + file} lang="es" selected={lang === "es"}>Español</option>
      </select>
      <label class="visually-hidden" for="theme">{s.theme}</label>
      <select id="theme" class="pref">
        <option value="system">{s.theme_system}</option>
        <option value="light">{s.theme_light}</option>
        <option value="dark">{s.theme_dark}</option>
      </select>
    </div>
    <nav aria-label={s.nav_label}>
      {nav.map((n) => <a href={n.url} aria-current={n.current ? "page" : undefined}>{n.label}</a>)}
    </nav>
  </header>

  <main id="main" class={doc ? "doc" : undefined}>
    <slot />
  </main>

  <footer>
    <p>{s.footer} <a href={`https://github.com/paveldelpozo/repoke/releases/tag/v${version}`}>repoke {version}</a>.</p>
    <p><a href="https://github.com/paveldelpozo/repoke">{s.source}</a> <span aria-hidden="true">·</span> <a href="https://github.com/paveldelpozo/repoke/releases">Releases</a> <span aria-hidden="true">·</span> <a href="https://crates.io/crates/repoke">crates.io</a> <span aria-hidden="true">·</span> <a href="https://github.com/paveldelpozo/repoke-plugins">{s.plugins}</a></p>
    <p><a href="https://paveldelpozo.es/privacidad">{s.privacy}</a> <span aria-hidden="true">·</span> <button type="button" class="link" data-consent-open>{s.consent_label}</button></p>
  </footer>

  <div id="consent" class="consent" data-ga-id="G-THB40Z7HTL" role="region" aria-label={s.consent_label} hidden>
    <p>{s.consent_text} <a href="https://paveldelpozo.es/privacidad">{s.privacy}</a></p>
    <div class="consent-actions">
      <button type="button" class="copy" data-consent="granted">{s.consent_accept}</button>
      <button type="button" class="copy" data-consent="denied">{s.consent_decline}</button>
    </div>
  </div>
</body>
</html>
