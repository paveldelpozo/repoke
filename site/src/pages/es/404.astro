---
import Base from "../../layouts/Base.astro";
import { BASE } from "../../site.js";
import strings from "../../strings.json";

const s = strings.es.not_found;
---
<Base lang="es" name="404">
  <section class="intro">
    <h1>{s.title}</h1>
    <p class="lead">{s.text}</p>
    <p><a href={BASE.es}>{s.home}</a> <span aria-hidden="true">·</span> <a href={BASE.es + "commands.html"}>{s.commands}</a></p>
  </section>
</Base>
